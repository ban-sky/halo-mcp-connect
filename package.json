{
  "name": "halo-mcp-connect",
  "version": "1.2.0",
  "private": true,
  "description": "Connect DeepSeek Harness (DSH) to a Halo blog through the Halo MCP server plugin, with a settings card and hot reload.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "halo",
    "mcp"
  ]
}
